# Caviar backend environment - copy to .env and fill in real values.
# Never commit a real .env. The frontend must NEVER receive any key in
# this file except (eventually, in its own env) the Supabase anon key.

APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173

# Async SQLAlchemy URL (postgresql+asyncpg driver).
DATABASE_URL=postgresql+asyncpg://caviar:caviar@localhost:5432/caviar

# --- Supabase (Phase 2: auth, Phase 3: storage) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# JWT verification - configure EXACTLY ONE mode:
#SUPABASE_JWT_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
#SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Anon (publishable) key for Storage REST calls (NOT the service-role key).
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Gemini AI (Phase 4: Resume Intelligence, Phase 6: Resume Builder) ---
GEMINI_API_KEY=your-gemini-api-key
# Task-based model routing (per-task env vars; later phases add their own).
#RESUME_ANALYSIS_MODEL=gemini-3.5-flash
#CONTENT_ASSIST_MODEL=gemini-3.5-flash

# --- Phase 3 tuning (defaults shown) ---
#RESUMES_BUCKET=resumes
#RESUME_MAX_FILE_SIZE_BYTES=10485760
#RESUME_MAX_PAGE_COUNT=15
#STORAGE_TIMEOUT_SECONDS=30
#STORAGE_SIGNED_URL_EXPIRES_SECONDS=300
#RESUME_UPLOAD_RATE_LIMIT_MAX=10
#RESUME_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Phase 4 tuning (defaults shown) ---
#AI_TIMEOUT_SECONDS=90
#AI_MAX_OUTPUT_TOKENS=8192
#AI_TEMPERATURE=0.2
#AI_MAX_RESUME_CHARS=40000
#AI_MAX_JOB_DESCRIPTION_CHARS=20000
#RESUME_ANALYSIS_RATE_LIMIT_MAX=10
#RESUME_ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Phase 6 tuning (defaults shown) ---
#CONTENT_ASSIST_RATE_LIMIT_MAX=20
#CONTENT_ASSIST_RATE_LIMIT_WINDOW_SECONDS=3600

# Phase 5 (deterministic scoring engine) adds no environment variables:
# weights and rules are versioned application code, never configuration.
